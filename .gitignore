# ---------------------------------------------------------------- secrets
# Credentials live in the environment with NO default, so a missing one fails
# loudly rather than silently falling back to a checked-in sandbox account.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- raw captures
# Responses come off a vendor sandbox carrying third-party guest data: names,
# email addresses, phone numbers and free-text remarks. Only PSEUDONYMISED
# fixtures are committed (tools/scrub_fixtures.py, slice 2). Raw captures stay
# on the machine that made them.
fixtures/**/raw/
*.raw.xml
*.raw.json

# ---------------------------------------------------------------- v1 codebase
# miniHotelLegacy/ is kept locally as the specification input for v2 and is
# referenced throughout docs/. It is NOT committed: it contains unscrubbed guest
# data in probe/ and hard-coded sandbox credentials in verify_api.py, and this
# repository is public. It can be committed once the slice-2 scrubber has been
# run over it and the credentials moved to the environment.
miniHotelLegacy/

# ---------------------------------------------------------------- Anish's POC
# ruleEngineAnishLegacy/ is a separate 727-line proof of concept built against
# the SAME three StayOps requirement documents, kept locally as the input for
# the comparison report in docs/. NOT committed: it is someone else's codebase,
# it carries a seeded poc.db of working state, and the report quotes what a
# reader needs. Same treatment as miniHotelLegacy/ above, and for the same
# reason - this repository is public.
ruleEngineAnishLegacy/

# ---------------------------------------------------------------- generated
runs/
# ...but not the golden payloads of /api/runs/<run_id>, which are committed evidence of
# the API contract (tools/dump_api_fixtures.py). Without this line the rule above drops
# them silently, and the rebuild test passes locally and fails in CI.
!fixtures/api/runs/
*.sqlite3
*.db
docs/generated/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------- os / editor
.DS_Store
.idea/
.vscode/
