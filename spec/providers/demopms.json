      "probe": "room-types.json",
      "transform": null
    },
    {
      "canonical": "folio.balance_due",
      "endpoint": "ledger",
      "path": "ledger.balance",
      "probe": "ledger_007004348.json",
      "transform": "money_object",
      "notes": "R9 - in the ledger's own currency, which on this hotel differs from the booking's exactly as it does on the other provider"
    },
    {
      "canonical": "folio.currency",
      "endpoint": "ledger",
      "path": "ledger.balance.currency",
      "probe": "ledger_007004348.json",
      "transform": null,
      "notes": "R9"
    },
    {
      "canonical": "folio.total_charged",
      "endpoint": "ledger",
      "path": "ledger.charged",
      "probe": "ledger_007004348.json",
      "transform": "money_object"
    },
    {
      "canonical": "folio.total_paid",
      "endpoint": "ledger",
      "path": "ledger.paid",
      "probe": "ledger_007004348.json",
      "transform": "money_object"
    },
    {
      "canonical": "folio.transactions[].department",
      "endpoint": "ledger",
      "path": "ledger.postings[].category",
      "probe": "ledger_007004348.json",
      "transform": "tenant_department_map",
      "notes": "A5 - posting categories are configured per property on any PMS"
    },
    {
      "canonical": "folio.transactions[].kind",
      "endpoint": "ledger",
      "path": "ledger.postings[].direction",
      "probe": "ledger_007004348.json",
      "transform": "charge_payment"
    },
    {
      "canonical": "folio.transactions[].amount",
      "endpoint": "ledger",
      "path": "ledger.postings[].value",
      "probe": "ledger_007004348.json",
      "transform": "money_object"
    },
    {
      "canonical": "folio.transactions[].date",
      "endpoint": "ledger",
      "path": "ledger.postings[].posted_on",
      "probe": "ledger_007004348.json",
      "transform": "date_dmy_to_iso"
    },
    {
      "canonical": "occupancy.room_number",
      "endpoint": "occupancy",
      "path": "rooms[].room_no",
      "probe": "occupancy.json",
      "transform": null,
      "notes": "THE NESTED QUIRK. A segment carries no room number of its own; it reads the one on the room CONTAINING it. The other provider returns rooms and reservations as sibling lists, where each segment stands alone. Same canonical answer, opposite shapes - which is the point of the boundary above"
    },
    {
      "canonical": "occupancy.reservation_id",
      "endpoint": "occupancy",
      "path": "rooms[].occupancy[].booking_ref",
      "probe": "occupancy.json",
      "transform": null,
