    },
    {
      "canonical": "occupancy.from",
      "endpoint": "occupancy",
      "path": "rooms[].occupancy[].from",
      "probe": "occupancy.json",
      "transform": "date_dmy_to_iso"
    },
    {
      "canonical": "occupancy.to",
      "endpoint": "occupancy",
      "path": "rooms[].occupancy[].to",
      "probe": "occupancy.json",
      "transform": "date_dmy_to_iso"
    },
    {
      "canonical": "occupancy.status",
      "endpoint": "occupancy",
      "path": "rooms[].occupancy[].state",
