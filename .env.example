# Credentials for the LIVE transport. Copy to .env, fill in, and export before probing.
#
# There is no default for any of these anywhere in the code. A missing one fails loudly at the
# point of use (finding F15) rather than falling back to a checked-in sandbox account - which
# is what v1 did, in a file about to be pushed to a public repository.
#
# .env and .env.* are git-ignored; this example file is the only one committed.

# Lock 1: the transport is off unless this is set. Lock 2 is the process - it refuses to arm
# while a test runner is loaded, so no test can reach the network whatever this says.
HOTELCONTROLS_LIVE=0

# One block per provider. The variable names are built from the provider's own name, so a third
# PMS needs no code change here either:  HOTELCONTROLS_<PROVIDER>_<FIELD>
HOTELCONTROLS_MINIHOTEL_BASE_URL=https://sandbox.example.invalid
HOTELCONTROLS_MINIHOTEL_USER=
HOTELCONTROLS_MINIHOTEL_PASSWORD=
HOTELCONTROLS_MINIHOTEL_HOTEL=

# Before any live call, read decision D3 in docs/open-questions.md: calls to the vendor sandbox
# are approved individually, bounded and staged (R8). `python3 -m tools.probe --plan` prints
# what a probe would ask for and makes no calls at all.

# ---------------------------------------------------------------------------------------
# The COMPOSE front end (slice 13, decision D10). Entirely separate from the transport
# above: this talks to a MODEL, never to a PMS.
#
# Same two locks, for the same reason. Lock 1 is this variable; lock 2 is the process, which
# refuses to arm while a test runner is loaded - so no test reaches a model whatever this
# says, and the test that sets it is refused anyway.
HOTELCONTROLS_COMPOSE=0

# The DEFAULT backend: a model on your own machine. Free, offline, no key, and no dependency -
# it is reached with `urllib` from the standard library.
#     brew install ollama && ollama pull qwen2.5:7b && ollama serve
#     HOTELCONTROLS_COMPOSE=1 python3 -m tools.serve --llm local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# The OPTIONAL hosted backend. Paid - roughly a quarter of a cent per attempt once the
# vocabulary is cached - and needs `pip install -r requirements-llm.txt`.
#     HOTELCONTROLS_COMPOSE=1 python3 -m tools.serve --llm claude
# No default key, ever. Unset fails at the point of use rather than becoming an anonymous
# request. Raise ANTHROPIC_MODEL to claude-opus-5 if a drafted sentence is wrong often enough
# to be worth the difference.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Neither is needed for `--llm stub`, which has fixed replies and no model behind it at all.
